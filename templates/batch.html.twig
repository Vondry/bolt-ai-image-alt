{% extends '@bolt/_base/layout.html.twig' %}
{% import '@bolt/_macro/_macro.html.twig' as macro %}

{% block shoulder %}
    AI ALT
{% endblock shoulder %}

{% block title %}
    {{ macro.icon('magic') }}
    {{ title }}
{% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ aiAlt.assetBase }}/ai-alt.css{{ aiAlt.assetVersion is defined and aiAlt.assetVersion ? '?v=' ~ aiAlt.assetVersion }}">
{% endblock %}

{% block main %}
    {% if not enabled %}
        <div class="alert alert-warning">AI ALT is disabled in <code>config/extensions/tomvondracek-aialt.yaml</code>.</div>
    {% else %}
        <div id="ai-alt-batch" class="ai-alt-batch">
            <noscript>JavaScript is required.</noscript>
        </div>

        <script type="application/json" id="ai-alt-config">{{ configJson|raw }}</script>
        <script type="module" src="{{ aiAlt.assetBase }}/ai-alt-batch.js{{ aiAlt.assetVersion is defined and aiAlt.assetVersion ? '?v=' ~ aiAlt.assetVersion }}"></script>
    {% endif %}
{% endblock main %}
